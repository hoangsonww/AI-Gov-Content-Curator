# ──────────────────────────────────────────────────────────────────────────
# SynthoraAI Agentic Pipeline — environment configuration template.
# Copy to `.env` and fill in real values. Never commit `.env`.
# Settings model: agentic_ai/config/settings.py
# ──────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────
# `development` lets `cp .env.example .env && docker compose up` boot the
# stack without provider keys. Set to `production` for real deployments —
# production fails fast unless the DEFAULT_LLM_PROVIDER key is supplied.
ENVIRONMENT=development              # development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true
APP_NAME=SynthoraAI Agentic Pipeline
APP_VERSION=1.0.0

# ── HTTP API ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ALLOW_ORIGINS=              # comma-separated; empty disables CORS in prod
API_TRUSTED_HOSTS=*                  # comma-separated; restrict in prod (e.g. api.example.com)

# ── MCP Server ───────────────────────────────────────────────────────────
MCP_SERVER_NAME=synthora-agentic-pipeline
MCP_SERVER_VERSION=1.0.0
MCP_PORT=8001
MCP_MAX_CONNECTIONS=100
MCP_MAX_CONTENT_CHARS=20000
MCP_MAX_METADATA_ENTRIES=50
MCP_MAX_METADATA_VALUE_CHARS=2000
MCP_MAX_BATCH_ITEMS=25
MCP_MAX_JOB_HISTORY=1000
MCP_JOB_TTL_SECONDS=86400

# ── ACP ──────────────────────────────────────────────────────────────────
ACP_ENABLED=true
ACP_BACKEND=redis                    # redis | memory
ACP_MAX_AGENTS=200
ACP_MAX_MESSAGES=5000
ACP_MESSAGE_TTL_SECONDS=3600
ACP_AGENT_TTL_SECONDS=900
ACP_REDIS_KEY_PREFIX=synthora:acp
ACP_MAX_PAYLOAD_CHARS=20000
ACP_MAX_METADATA_ENTRIES=50
ACP_MAX_CAPABILITIES=32

# ── LLM providers (set the one(s) you use) ───────────────────────────────
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

DEFAULT_LLM_PROVIDER=google          # google | openai | anthropic | cohere
DEFAULT_MODEL=gemini-1.5-flash
TEMPERATURE=0.7
MAX_TOKENS=2000

# LLM resilience
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_CIRCUIT_FAIL_MAX=5
LLM_CIRCUIT_RESET_SECONDS=30

# ── Vector store ─────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=synthora-ai

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=synthora_ai

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false

# ── AWS ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Azure ────────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_APP_INSIGHTS_CONNECTION_STRING=

# ── GCP ──────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Agent execution ──────────────────────────────────────────────────────
MAX_ITERATIONS=10
AGENT_TIMEOUT=300
ENABLE_HUMAN_IN_LOOP=false

# ── Rate limiting (API + tool middleware) ────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Monitoring / OpenTelemetry ───────────────────────────────────────────
ENABLE_METRICS=true
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=         # e.g. http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc     # grpc | http/protobuf
OTEL_TRACES_SAMPLE_RATIO=1.0
OTEL_RESOURCE_ATTRIBUTES=

# ── Feature flags ────────────────────────────────────────────────────────
ENABLE_CONTENT_ANALYSIS=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_SUMMARIZATION=true
ENABLE_CLASSIFICATION=true

# ── Cost guard rails ─────────────────────────────────────────────────────
DAILY_COST_BUDGET_USD=50.0
COST_ALERT_THRESHOLD=0.8
